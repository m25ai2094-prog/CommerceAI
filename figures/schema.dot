digraph schema {
  graph [bgcolor="white", rankdir=TB, ranksep=.47, nodesep=.20, pad=.20];
  node [shape=box, style="rounded,filled", color="#59756b", fillcolor="#f0f3e9", fontname="DejaVu Sans", fontsize=11, margin=".13,.09"];
  edge [color="#556a63", arrowsize=.59];
  tenant [label="Tenant\nslug", fillcolor="#ddeae0"];
  profile [label="Customer\n(tenant, customer)"];
  catalogue [label="Product\n(tenant, SKU)"];
  policy [label="Knowledge\n(tenant, source, version)"];
  order [label="Order\n(tenant, reference)"];
  line [label="Order line\n(tenant, order, line)"];
  returns [label="Return\n(tenant, order, line)"];
  refund [label="Refund\n(tenant, reference)"];
  ticket [label="Ticket\n(tenant, reference)"];
  note [label="Ticket message\n(tenant, ticket, id)"];
  log [label="Operations, activity and audit\nTenant and correlation"];
  tenant -> {profile catalogue policy log};
  profile -> {order ticket};
  ticket -> note;
  order -> {line refund};
  catalogue -> line;
  line -> returns;
  {rank=same;profile;catalogue;policy;log}
  {rank=same;order;ticket}
}
